{
  "name": "website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/website/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/website"],
      "options": {
        "command": "docusaurus build packages/website --out-dir ../../dist/packages/website"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docusaurus start packages/website --port 3000"
      }
    }
  },
  "tags": []
}
